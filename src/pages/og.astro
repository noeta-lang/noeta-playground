---
/* Screenshot target for the 1200×630 social-share card. Rendered at build time
 * only — scripts/build-og-image.mjs serves dist/, screenshots /og into
 * dist/images/og-image.png, then deletes dist/og/ so it never ships. The card
 * is always the dark "Signal" palette — the token block below re-pins the dark
 * values so it renders the same regardless of the screenshot browser's
 * color-scheme. */
import "@noeta/theme/fonts.css";
import "@noeta/theme/theme.css";
import { highlightNoeta } from "@noeta/theme/highlight";

const SNIPPET = `fn fib(n: int): int {
  if n < 2 { return n; }
  return fib(n - 1) + fib(n - 2);
}

echo "fib(16) = \${fib(16)}"`;
const code = highlightNoeta(SNIPPET);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex,nofollow" />
    <title>og image — noeta playground</title>
    <style>
      :root {
        --bg: #0b0d10;
        --surface-1: #111419;
        --surface-2: #171b21;
        --surface-3: #1f242c;
        --text-0: #e8ebef;
        --text-1: #a3adba;
        --text-2: #69727e;
        --accent: #4f8ff7;
        --accent-2: #4fe0a8;
        --accent-2-bright: #7defc0;
        --danger: #e5766a;
        --syn-keyword: #5fe0b0;
        --syn-string: #8fd6a0;
        --syn-number: #e0a878;
        --syn-type: #8fb8f5;
        --syn-fn: #cdd6e0;
        --syn-tag: #5fe0b0;
        --syn-comment: #69727e;
        --syn-hole: #7defc0;
        --line: rgba(233, 237, 243, 0.08);
        --line-strong: rgba(233, 237, 243, 0.14);
      }
      html,
      body {
        width: 1200px;
        height: 630px;
        margin: 0;
        overflow: hidden;
      }
      .og-canvas {
        position: relative;
        width: 1200px;
        height: 630px;
        display: flex;
        flex-direction: column;
        padding: 56px 64px 48px;
        background:
          radial-gradient(70rem 40rem at 82% -20%, rgba(79, 143, 247, 0.14), transparent 62%),
          radial-gradient(55rem 32rem at -10% 115%, rgba(79, 224, 168, 0.08), transparent 60%),
          var(--bg);
      }
      .og-mast {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-family: var(--font-mono);
        font-size: 17px;
        color: var(--text-2);
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .og-mast .brand {
        font-family: var(--font-body);
        font-size: 28px;
        font-weight: 620;
        letter-spacing: -0.02em;
        text-transform: none;
        color: var(--text-0);
      }
      .og-mast .brand .tld {
        color: var(--text-2);
        font-weight: 500;
      }
      .og-main {
        flex: 1;
        display: grid;
        grid-template-columns: 560px 1fr;
        gap: 44px;
        align-items: center;
      }
      .og-headline {
        margin: 0;
        font-family: var(--font-body);
        font-weight: 680;
        font-size: 80px;
        line-height: 1.02;
        letter-spacing: -0.038em;
        color: var(--text-0);
      }
      .og-headline .accent {
        color: var(--accent);
      }
      .og-dek {
        margin: 26px 0 0;
        font-family: var(--font-body);
        font-size: 23px;
        line-height: 1.5;
        color: var(--text-1);
        max-width: 540px;
      }
      .og-code {
        border: 1px solid var(--line-strong);
        border-radius: 12px;
        background: var(--surface-1);
        overflow: hidden;
        box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.85);
      }
      .og-code .bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--line);
        background: var(--surface-2);
        font-family: var(--font-mono);
        font-size: 14px;
        color: var(--text-1);
      }
      .og-code .dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: var(--surface-3);
        border: 1px solid var(--line-strong);
      }
      .og-code .dot.lit {
        background: var(--accent-2);
        border-color: var(--accent-2);
        box-shadow: 0 0 12px rgba(79, 224, 168, 0.6);
      }
      .og-code .bp {
        display: inline-block;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: var(--danger);
        box-shadow: 0 0 10px rgba(229, 118, 106, 0.7);
        margin-right: 10px;
      }
      .og-code pre {
        margin: 0;
        padding: 20px 22px;
        font-family: var(--font-mono);
        font-size: 15px;
        line-height: 1.72;
        color: var(--text-0);
      }
      .og-foot {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        font-family: var(--font-mono);
        font-size: 18px;
        color: var(--accent);
      }
      .og-foot .quiet {
        color: var(--accent-2-bright);
        font-size: 16px;
      }
    </style>
  </head>
  <body>
    <div class="og-canvas">
      <header class="og-mast">
        <span class="brand">noeta<span class="tld">.dev/play</span></span>
        <span>Playground</span>
      </header>
      <main class="og-main">
        <div>
          <h1 class="og-headline">Run it <span class="accent">right here.</span></h1>
          <p class="og-dek">
            The real Noeta toolchain in your browser — diagnostics, hover types, completion, and a
            debugger with breakpoints. No backend, nothing leaves the tab.
          </p>
        </div>
        <div class="og-code">
          <div class="bar">
            <span class="dot lit"></span>
            <span class="dot"></span>
            <span class="dot"></span>
            <span>playground.noe</span>
          </div>
          <pre><code set:html={code} /></pre>
        </div>
      </main>
      <footer class="og-foot">
        <span>play.noeta.dev</span>
        <span class="quiet">run · debug · format · share</span>
      </footer>
    </div>
  </body>
</html>
