---
/* Page shell: the shared @noeta/theme (fonts + tokens + chrome), this site's
 * playground styles, head, header/footer, and the fixed atmospheric
 * background. */
import "@noeta/theme/fonts.css";
import "@noeta/theme/theme.css";
import "../styles/playground.css";
import BaseHead from "../components/BaseHead.astro";
import { renderHeader, renderFooter, DRAWER_SCRIPT } from "@noeta/theme/chrome";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const { title, description, path } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} path={path} />
  </head>
  <body>
    <div class="field" aria-hidden="true"></div>
    <Fragment set:html={renderHeader({ site: "playground", version: SITE.version })} />
    <slot />
    <Fragment
      set:html={renderFooter({
        site: "playground",
        footMeta:
          "Everything here runs in your tab — the real Noeta toolchain compiled to WebAssembly. " +
          "Nothing you type leaves the browser (share links live in the URL fragment).",
      })}
    />
    <script is:inline set:html={DRAWER_SCRIPT} />
  </body>
</html>
