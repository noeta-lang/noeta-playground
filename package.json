{
  "name": "noeta-playground",
  "version": "0.1.0",
  "private": true,
  "description": "The Noeta language playground \u2014 the real toolchain in your browser: run, format, IDE smarts, and a debugger, all client-side WASM. play.noeta.dev.",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "sync-engine": "node scripts/sync-engine.mjs",
    "sync-grammars": "node scripts/sync-grammars.mjs",
    "predev": "node scripts/sync-engine.mjs && node scripts/sync-grammars.mjs",
    "prebuild": "node scripts/sync-engine.mjs && node scripts/sync-grammars.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/build-og-image.mjs",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "astro check",
    "check:examples": "node --experimental-strip-types scripts/check-examples.mjs",
    "check:overflow": "node node_modules/@noeta/theme/scripts/check-overflow.mjs --dist dist",
    "check:chrome": "node node_modules/@noeta/theme/scripts/check-chrome.mjs --dist dist",
    "test": "node --test 'src/lib/*.test.ts'"
  },
  "dependencies": {
    "@noeta/theme": "file:../noeta-theme",
    "monaco-editor": "^0.55.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.9",
    "playwright-core": "^1.61.1",
    "shiki": "^4.3.1",
    "typescript": "^5.9.3",
    "wrangler": "~4.112.0"
  }
}
